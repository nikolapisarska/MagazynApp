<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
               x:Class="MagazynApp.Views.VerificationSummaryPopup"
               Color="Transparent">

    <!-- Kontener z zaokrąglonymi rogami w ciemnym motywie -->
    <Border BackgroundColor="#1E1E1E" 
            Stroke="#333333"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 20" 
            WidthRequest="400" 
            HeightRequest="700" 
            Padding="0">
        
        <Grid RowDefinitions="Auto, *, Auto">
            
            <!-- Nagłówek -->
            <Grid Grid.Row="0" BackgroundColor="#252525" HeightRequest="60" ColumnDefinitions="*">
                <Label Text="Podsumowanie Weryfikacji" 
                       TextColor="White" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       VerticalOptions="Center" 
                       HorizontalOptions="Center"/>
            </Grid>

            <!-- Lista produktów z weryfikacji (tylko z problemami/brakami) -->
            <CollectionView Grid.Row="1" ItemsSource="{Binding VerificationItems}" Margin="12" BackgroundColor="Transparent">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                        <Label Text="Wszystko jest w porządku! Brak braków i uszkodzeń." 
                               TextColor="Green" 
                               FontSize="14" 
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4" 
                                Padding="12" 
                                StrokeShape="RoundRectangle 8" 
                                BackgroundColor="#2A2A2A" 
                                Stroke="#3A3A3A"
                                StrokeThickness="1">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding ProductName}" FontAttributes="Bold" FontSize="15" TextColor="White"/>
                                <Label Text="{Binding ProductId}" FontSize="12" TextColor="#9E9E9E"/>
                                <Label Text="{Binding StatusLabel}" FontSize="12" TextColor="{Binding StatusColor}" FontAttributes="Bold"/>
                                <Label Text="{Binding Notes, StringFormat='Uwagi: {0}'}" 
                                       FontSize="11" 
                                       TextColor="#BDBDBD" 
                                       FontAttributes="Italic"
                                       IsVisible="{Binding HasNotes}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Stopka z przyciskiem zamykającym -->
            <HorizontalStackLayout Grid.Row="2" Spacing="10" Padding="15" HorizontalOptions="Center" BackgroundColor="#1E1E1E">
                <Button Text="Zamknij" 
                        Clicked="OnCloseClicked" 
                        WidthRequest="160" 
                        HeightRequest="45"
                        BackgroundColor="#303030" 
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="6"/>
            </HorizontalStackLayout>
            
        </Grid>
    </Border>
</toolkit:Popup>